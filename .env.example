# Server-side Base mainnet RPC URL(s), read by server/thetanuts.ts and used
# for the rpcConfigured flag in server/app.ts's /healthz. Comma-separated for
# a primary + fallback list. Optional; defaults to https://mainnet.base.org.
BASE_RPC_URL=https://your-base-rpc-provider.example/v2/your-api-key

# Server-side prototype Premium access via POST /api/login (server/login.ts).
# Optional override.
# If omitted, the hackathon demo code is NUTSCOPE2026.
PREMIUM_PASSWORD=

# Google Gemini API key used by the AI Analyst via POST /api/chat (server/aiAnalyst.ts).
# Without this set, the AI Analyst always responds 503 "temporarily unavailable".
GEMINI_API_KEY=your-gemini-api-key

# Port the production server (start.ts) listens on. Optional — Render and most
# hosting platforms set this automatically; defaults to 8080 if unset locally.
PORT=8080
